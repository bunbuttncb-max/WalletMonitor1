# Telegram Bot configuration
BOT_TOKEN=your_telegram_bot_token_here

# TronScan API configuration (https://tronscan.org/)
TRONSCAN_API_KEY=your_tronscan_api_key_here

# Poll interval in seconds
POLL_INTERVAL=10

# Optional extra notification chat ID
NOTIFY_CHAT_ID=

# SQLite database path
DB_PATH=wallets.db

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional HTTP proxy, for example: http://127.0.0.1:7890
PROXY_URL=

# Optional TRX receiving address for energy rental feature
ENERGY_TRX_ADDRESS=

# Spaceship domain availability API
SPACESHIP_API_KEY=
SPACESHIP_API_SECRET=
SPACESHIP_API_BASE=https://spaceship.dev/api/v1
# 检测间隔按域名数量自动计算（Spaceship：30 请求/30 秒；单域名最小 60 秒）
DOMAIN_CHECK_INTERVAL_MIN=60
DOMAIN_CHECK_IDLE_INTERVAL=300
DOMAIN_CHECK_START=01:20
DOMAIN_CHECK_END=03:30
DOMAIN_NOTIFY_COUNT=5
DOMAIN_NOTIFY_INTERVAL=10
# 检测时段内「检测进行中」通知间隔（秒），默认 180 = 每 3 分钟
DOMAIN_PROGRESS_NOTIFY_INTERVAL=180

# Web admin bind address and token
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8080
ADMIN_TOKEN=change_this_admin_token
